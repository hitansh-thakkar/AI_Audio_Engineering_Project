# Dhvani credentials template. Copy to .env and fill in.
#   cp .env.example .env     (Windows PowerShell: Copy-Item .env.example .env)

# pyannote.ai API key (precision-2 cloud diarization — best quality).
# Sign up + get key: https://dashboard.pyannote.ai
# Without this key the pipeline falls back to the free local community-1 model.
PYANNOTE_API_KEY=pyannote_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Free Hugging Face token (pyannote community-1 fallback + gated models).
# Token: https://huggingface.co/settings/tokens
# Accept BOTH licenses: pyannote/speaker-diarization-community-1 AND pyannote/segmentation
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Free Google Gemini API key (ASR fallback). https://aistudio.google.com/apikey
GEMINI_API_KEY=AIxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Groq API key (Stage 5 LLM post-processing). https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
